# Vorlage fuer .env — Werte eintragen und als .env speichern (nie committen).

# Supabase (Datenbank und Dateispeicher). Der Service-Role-Key bleibt
# ausschliesslich auf dem Server; alle Zugriffe laufen ueber die API-Routen.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Oeffentliche Adresse der Seite (Links in Mails, Sitemap, Open Graph)
NEXT_PUBLIC_BASE_URL=https://sygs.de

# Mailversand (Kontaktformular, Bestaetigungen, Aufgaben-Erinnerungen)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@sygs.de
SMTP_PASS=
# Optional: abweichende Absender-/Empfaengeradresse (Standard: SMTP_USER bzw. info@sygs.de)
# MAIL_FROM=
# MAIL_TO=

# IMAP fuer das Admin-Postfach (Benutzer/Passwort fallen auf SMTP_USER/SMTP_PASS zurueck)
IMAP_HOST=
IMAP_PORT=993

# Geheimnisse fuer Login-Token und Formular-Token. Lange Zufallswerte;
# fehlen sie, wird ersatzweise der Supabase-Key verwendet.
JWT_SECRET=
FORM_TOKEN_SECRET=

# Secret fuer den Aufgaben-Erinnerungs-Job (/api/cron/task-reminders).
# Muss im Scheduler (GitHub Action / Vercel Cron) identisch gesetzt sein.
CRON_SECRET=

# Soziale Kanaele — leer lassen, dann erscheint das Symbol nicht
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
